# ==============================================================================
# WELLCALL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or .env.local before running locally.
# DO NOT COMMIT REAL SECRETS OR API KEYS TO GIT.
# ==============================================================================

# Fastify + Socket.io Gateway Server Port
GATEWAY_PORT=3001

# Deepgram Speech-to-Text API Key
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Anthropic Claude API Key (Prompt-constrained Tool Extraction)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Rime TTS API Key (Coda voice model for warm dialogue synthesis)
RIME_API_KEY=your_rime_api_key_here

# Qdrant Vector Database URL & API Key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Dashboard Gateway REST API Base Endpoint
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
