# Deepgram Speech-to-Text API Key for real-time patient voice transcription
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Groq API Key (llama-3.3-70b-versatile) for clinical field extraction
GROQ_API_KEY=your_groq_api_key_here

# Rime TTS API Key for warm, natural dialogue voice synthesis
RIME_API_KEY=your_rime_api_key_here

# Rime speaker voice name (default: celeste). Other voices: anatole, cove, etc.
RIME_SPEAKER=celeste

# Qdrant Vector Database connection URL (default local instance)
QDRANT_URL=http://localhost:6333

# Qdrant Vector Database API Key (optional for local deployment)
QDRANT_API_KEY=your_qdrant_api_key_here

# Gateway Server HTTP & Socket.io port
GATEWAY_PORT=3001

# Twilio Account SID for telephony client authentication
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Twilio Auth Token for API request authentication
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio Phone Number used to initiate outgoing patient calls
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Twilio WhatsApp Sandbox number for nurse escalation alerts (no country restrictions, unlike SMS)
TWILIO_WHATSAPP_FROM=+17372508034

# On-call Nurse Phone Number for urgent clinical escalation transfers
NURSE_PHONE_NUMBER=your_nurse_phone_number_here

# Dashboard (Next.js) URL for CORS and gateway API access
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001

